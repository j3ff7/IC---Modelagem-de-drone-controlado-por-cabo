<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="carretel_ancora">
    <self_collide>true</self_collide>
    
    <link name="base_suporte">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>12.0</mass> 
        <!-- Inércia ajustada para uma caixa de 0.4 x 0.7 x 0.10 -->
        <inertia><ixx>0.50</ixx><iyy>0.17</iyy><izz>0.65</izz></inertia>
      </inertial>

      <!-- Placa do Chão (Altura ajustada para 1/3 da haste: 0.10m) -->
      <visual name="base_visual">
        <pose>0 0 0.05 0 0 0</pose>
        <geometry><box><size>0.4 0.7 0.10</size></box></geometry>
        <!-- Adicionada uma cor cinza mais clara e metálica -->
        <material>
          <ambient>0.4 0.4 0.4 1</ambient>
          <diffuse>0.5 0.5 0.5 1</diffuse>
        </material>
      </visual>
      <collision name="base_colisao">
        <pose>0 0 0.05 0 0 0</pose>
        <geometry><box><size>0.4 0.7 0.10</size></box></geometry>
      </collision>

      <!-- Haste Esquerda -->
      <visual name="haste_esq_visual">
        <pose>0 0.23 0.15 0 0 0</pose> 
        <geometry><box><size>0.06 0.06 0.30</size></box></geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>
      <collision name="haste_esq_colisao">
        <pose>0 0.23 0.15 0 0 0</pose>
        <geometry><box><size>0.06 0.06 0.30</size></box></geometry>
      </collision>

      <!-- Haste Direita -->
      <visual name="haste_dir_visual">
        <pose>0 -0.23 0.15 0 0 0</pose>
        <geometry><box><size>0.06 0.06 0.30</size></box></geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>
      <collision name="haste_dir_colisao">
        <pose>0 -0.23 0.15 0 0 0</pose>
        <geometry><box><size>0.06 0.06 0.30</size></box></geometry>
      </collision>
    </link>

    <link name="cilindro_carretel">
      <pose>0 0 0.26 1.570796 0 0</pose> 
      <inertial>
        <mass>3.0</mass> 
        <inertia><ixx>0.02</ixx><iyy>0.02</iyy><izz>0.02</izz></inertia>
      </inertial>
      
      <!-- Corpo principal do carretel -->
      <visual name="cilindro_visual">
        <geometry><cylinder><radius>0.07</radius><length>0.40</length></cylinder></geometry>
        <material>
          <ambient>0.6 0.3 0.1 1</ambient>
          <diffuse>0.7 0.4 0.2 1</diffuse>
        </material>
      </visual>
      <collision name="cilindro_colisao">
        <geometry><cylinder><radius>0.07</radius><length>0.40</length></cylinder></geometry>
      </collision>

      <!-- Flange/Borda Direita do Carretel -->
      <visual name="borda_dir_visual">
        <pose>0 0 0.20 0 0 0</pose>
        <geometry><cylinder><radius>0.10</radius><length>0.02</length></cylinder></geometry>
        <material>
          <ambient>0.6 0.3 0.1 1</ambient>
          <diffuse>0.7 0.4 0.2 1</diffuse>
        </material>
      </visual>
      <collision name="borda_dir_colisao">
        <pose>0 0 0.20 0 0 0</pose>
        <geometry><cylinder><radius>0.10</radius><length>0.02</length></cylinder></geometry>
      </collision>

      <!-- Flange/Borda Esquerda do Carretel -->
      <visual name="borda_esq_visual">
        <pose>0 0 -0.20 0 0 0</pose>
        <geometry><cylinder><radius>0.10</radius><length>0.02</length></cylinder></geometry>
        <material>
          <ambient>0.6 0.3 0.1 1</ambient>
          <diffuse>0.7 0.4 0.2 1</diffuse>
        </material>
      </visual>
      <collision name="borda_esq_colisao">
        <pose>0 0 -0.20 0 0 0</pose>
        <geometry><cylinder><radius>0.10</radius><length>0.02</length></cylinder></geometry>
      </collision>
    </link>

    <joint name="junta_eixo" type="revolute">
      <parent>base_suporte</parent>
      <child>cilindro_carretel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
        <dynamics>
          <damping>0.05</damping>
          <friction>0.05</friction>
        </dynamics>
      </axis>
    </joint>
    
    <joint name="ancora_mundo" type="fixed">
      <parent>world</parent>
      <child>base_suporte</child>
    </joint>

    <plugin
      filename="gz-sim-joint-controller-system"
      name="gz::sim::systems::JointController">
      <joint_name>junta_eixo</joint_name>
      <topic>/carretel/velocidade</topic> 
    </plugin>
  </model>
</sdf>