<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="meu_drone_v2">

    <link name="cabo_sensor_link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.02</mass>
        <inertia>
          <ixx>2e-5</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>2e-5</iyy><iyz>0</iyz><izz>2e-5</izz>
        </inertia>
      </inertial>
      <visual name="visual">
        <geometry><sphere><radius>0.025</radius></sphere></geometry>
        <material><ambient>0.9 0.05 0.05 1</ambient><diffuse>0.9 0.05 0.05 1</diffuse></material>
      </visual>
    </link>

    <link name="cabo_azimuth_link">
      <pose relative_to="cabo_azimuth_joint">0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>1e-5</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1e-5</iyy><iyz>0</iyz><izz>1e-5</izz>
        </inertia>
      </inertial>
    </link>

    <joint name="cabo_azimuth_joint" type="revolute">
      <pose relative_to="cabo_sensor_link">0 0 0 0 0 0</pose>
      <parent>cabo_sensor_link</parent>
      <child>cabo_azimuth_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-3.14159</lower><upper>3.14159</upper><effort>2</effort><velocity>10</velocity></limit>
        <dynamics><damping>0.01</damping><friction>0.001</friction></dynamics>
      </axis>
    </joint>
    
    <link name="base_link">
      <pose relative_to="cabo_elevation_joint">0 0 0.05 0 0 0</pose> 
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.0547</ixx> <iyy>0.0558</iyy> <izz>0.0900</izz>
          <ixy>0</ixy> <ixz>0</ixz> <iyz>0</iyz>
        </inertia>
      </inertial>
      
      <visual name="base_link_visual">
        <pose>0 0 0 0 0 0</pose> 
        <geometry>
          <mesh>
            <uri>model://meu_drone/meshes/Drone_corpo_fixed.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </visual>
      
      <collision name="base_link_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://meu_drone/meshes/Drone_corpo_fixed.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </collision>
    </link>

    <link name="rotor_0">
      <pose relative_to="base_link">0.15 -0.10 0.05 0 0 0</pose> <inertial>
        <mass>0.005</mass>
        <inertia><ixx>0.0001</ixx> <iyy>0.0001</iyy> <izz>0.0001</izz></inertia>
      </inertial>
      <visual name="rotor_0_visual">
        <pose>0 0 0 0 0 0</pose> <geometry>
          <mesh>
            <uri>model://meu_drone/meshes/helice.STL</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material><ambient>1 0 0 1</ambient></material> </visual>
      <collision name="rotor_0_collision">
         <geometry><cylinder><radius>0.06</radius><length>0.01</length></cylinder></geometry>
      </collision>
    </link>

    <joint name="rotor_0_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_0</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e16</lower> <upper>1e16</upper></limit>
      </axis>
    </joint>

    <link name="rotor_1">
      <pose relative_to="base_link">-0.14 0.12 0.05 0 0 0</pose>
      <inertial>
        <mass>0.005</mass>
        <inertia><ixx>0.0001</ixx> <iyy>0.0001</iyy> <izz>0.0001</izz></inertia>
      </inertial>
      <visual name="rotor_1_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://meu_drone/meshes/helice.STL</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material><ambient>1 0 0 1</ambient></material> </visual>
      <collision name="rotor_1_collision">
         <geometry><cylinder><radius>0.06</radius><length>0.01</length></cylinder></geometry>
      </collision>
    </link>

    <joint name="rotor_1_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_1</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e16</lower> <upper>1e16</upper></limit>
      </axis>
    </joint>

    <link name="rotor_2">
      <pose relative_to="base_link">0.14 0.12 0.05 0 0 0</pose>
      <inertial>
        <mass>0.005</mass>
        <inertia><ixx>0.0001</ixx> <iyy>0.0001</iyy> <izz>0.0001</izz></inertia>
      </inertial>
      <visual name="rotor_2_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://meu_drone/meshes/helice.STL</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material><ambient>0 0 0 1</ambient></material> </visual>
      <collision name="rotor_2_collision">
         <geometry><cylinder><radius>0.06</radius><length>0.01</length></cylinder></geometry>
      </collision>
    </link>

    <joint name="rotor_2_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_2</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e16</lower> <upper>1e16</upper></limit>
      </axis>
    </joint>

    <link name="rotor_3">
      <pose relative_to="base_link">-0.15 -0.10 0.05 0 0 0</pose>
      <inertial>
        <mass>0.005</mass>
        <inertia><ixx>0.0001</ixx> <iyy>0.0001</iyy> <izz>0.0001</izz></inertia>
      </inertial>
      <visual name="rotor_3_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://meu_drone/meshes/helice.STL</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material><ambient>0 0 0 1</ambient></material> </visual>
      <collision name="rotor_3_collision">
         <geometry><cylinder><radius>0.06</radius><length>0.01</length></cylinder></geometry>
      </collision>
    </link>

    <joint name="rotor_3_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_3</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e16</lower> <upper>1e16</upper></limit>
      </axis>
    </joint>

    <joint name="cabo_elevation_joint" type="revolute">
      <pose relative_to="cabo_azimuth_link">0 0 0 0 0 0</pose>
      <parent>cabo_azimuth_link</parent>
      <child>base_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1.5708</lower><upper>1.5708</upper><effort>2</effort><velocity>10</velocity></limit>
        <dynamics><damping>0.01</damping><friction>0.001</friction></dynamics>
      </axis>
    </joint>

    <plugin
      filename="gz-sim-multicopter-control-system"
      name="gz::sim::systems::MulticopterVelocityControl">
      <robotNamespace>meu_drone</robotNamespace>
      <commandSubTopic>cmd_vel</commandSubTopic>
      <comLinkName>base_link</comLinkName>
      <velocityGain>4.0 4.0 6.0</velocityGain>
      <attitudeGain>2 3 0.15</attitudeGain>
      <angularRateGain>4.0 4.0 0.5</angularRateGain>
      
      <rotorConfiguration>
        <rotor>
          <jointName>rotor_0_joint</jointName>
          <forceConstant>1.5e-03</forceConstant>
          <momentConstant>0.090</momentConstant>
          <direction>-1</direction>
        </rotor>
        <rotor>
          <jointName>rotor_1_joint</jointName>
          <forceConstant>1.5e-03</forceConstant>
          <momentConstant>0.090</momentConstant>
          <direction>-1</direction>
        </rotor>
        <rotor>
          <jointName>rotor_2_joint</jointName>
          <forceConstant>1.5e-03</forceConstant>
          <momentConstant>0.090</momentConstant>
          <direction>1</direction>
        </rotor>
        <rotor>
          <jointName>rotor_3_joint</jointName>
          <forceConstant>1.5e-03</forceConstant>
          <momentConstant>0.090</momentConstant>
          <direction>1</direction>
        </rotor>
      </rotorConfiguration>
    </plugin>
    
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_0_joint</jointName>
      <linkName>rotor_0</linkName>
      <motorNumber>0</motorNumber>
      <turningDirection>cw</turningDirection>
      <motorConstant>1.5e-03</motorConstant>
      <momentConstant>0.090</momentConstant>
      <maxRotVelocity>1000</maxRotVelocity>
      <rotorVelocitySlowdownSim>5</rotorVelocitySlowdownSim>
      <robotNamespace>meu_drone</robotNamespace>
    </plugin>

    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_1_joint</jointName>
      <linkName>rotor_1</linkName>
      <motorNumber>1</motorNumber>
      <turningDirection>cw</turningDirection>
      <motorConstant>1.5e-03</motorConstant>
      <momentConstant>0.090</momentConstant>
      <maxRotVelocity>1000</maxRotVelocity>
      <rotorVelocitySlowdownSim>5</rotorVelocitySlowdownSim>
      <robotNamespace>meu_drone</robotNamespace>
    </plugin>

    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_2_joint</jointName>
      <linkName>rotor_2</linkName>
      <motorNumber>2</motorNumber>
      <turningDirection>ccw</turningDirection>
      <motorConstant>1.5e-03</motorConstant>
      <momentConstant>0.090</momentConstant>
      <maxRotVelocity>1000</maxRotVelocity>
      <rotorVelocitySlowdownSim>5</rotorVelocitySlowdownSim>
      <robotNamespace>meu_drone</robotNamespace>
    </plugin>

    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_3_joint</jointName>
      <linkName>rotor_3</linkName>
      <motorNumber>3</motorNumber>
      <turningDirection>ccw</turningDirection>
      <motorConstant>1.5e-03</motorConstant>
      <momentConstant>0.090</momentConstant>
      <maxRotVelocity>1000</maxRotVelocity>
      <rotorVelocitySlowdownSim>5</rotorVelocitySlowdownSim>
      <robotNamespace>meu_drone</robotNamespace>
    </plugin>

    <!-- PLUGIN DE ODOMETRIA (Sensor de posição) -->
    <plugin
      filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_topic>/meu_drone/odom</odom_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
      <dimensions>3</dimensions>
    </plugin>

   <!--<include>
      <uri>file:///home/lima/codes/ic/drone-cabo/src/pacote_do_drone/models/cabo.sdf</uri>
      <name>cabo_dinamico</name>
      <pose>0 0 0.14 0 1.5708 0</pose> 
    </include>

    <joint name="ancora_drone_cabo" type="fixed">
      <parent>base_link</parent>
      <child>cabo_dinamico::raiz_cabo</child> 
      <sensor name="sensor_tracao" type="force_torque">
        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <topic>/tensao_cabo</topic>
      </sensor>
    </joint>-->

    <plugin filename="gz-sim-forcetorque-system" name="gz::sim::systems::ForceTorque"/>

    <plugin
      filename="ignition-gazebo-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher"/>

  </model>
</sdf>
